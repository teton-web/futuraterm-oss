#!/bin/sh
# Submit a Moonlight pairing PIN to Sunshine on this machine.
# Talks only to https://127.0.0.1:47990. Never prints the admin password.
set -eu

PIN=""
NAME="Mac"
PRINT_JSON=0

while [ $# -gt 0 ]; do
  case "$1" in
    --pin)
      PIN="${2:-}"
      shift 2
      ;;
    --name)
      NAME="${2:-}"
      shift 2
      ;;
    --print-json)
      PRINT_JSON=1
      shift
      ;;
    *)
      echo "error: unknown argument $1" >&2
      exit 2
      ;;
  esac
done

case "$PIN" in
  [0-9][0-9][0-9][0-9]) ;;
  *)
    echo "error: --pin must be 4 digits" >&2
    exit 2
    ;;
esac

# Pair helper is invoked from ssh as sh -c; keep the client name free of quotes.
NAME="$(printf '%s' "$NAME" | tr -cd 'A-Za-z0-9._-' | cut -c1-32)"
if [ -z "$NAME" ]; then
  NAME="Mac"
fi

CREDS="${FUTURATERM_SUNSHINE_ADMIN:-$HOME/.config/futuraterm/sunshine-admin}"
if [ ! -f "$CREDS" ]; then
  echo "error: missing Sunshine admin file" >&2
  exit 1
fi

USER_NAME=""
PASSWORD=""
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    username=*) USER_NAME="${line#username=}" ;;
    password=*) PASSWORD="${line#password=}" ;;
  esac
done < "$CREDS"

if [ -z "$USER_NAME" ] || [ -z "$PASSWORD" ]; then
  echo "error: Sunshine admin file is incomplete" >&2
  exit 1
fi

JSON=$(printf '{"pin":"%s","name":"%s"}' "$PIN" "$NAME")
if [ "$PRINT_JSON" -eq 1 ]; then
  printf '%s\n' "$JSON"
  exit 0
fi

if ! command -v curl >/dev/null 2>&1; then
  echo "error: curl is required" >&2
  exit 1
fi

BASE="https://127.0.0.1:47990"
i=0
while [ "$i" -lt 20 ]; do
  code="$(curl -sk -o /dev/null -w '%{http_code}' -u "$USER_NAME:$PASSWORD" "$BASE/api/config" || true)"
  case "$code" in
    200 | 401 | 403) break ;;
  esac
  i=$((i + 1))
  sleep 0.25 2>/dev/null || sleep 1
done

post_pin() {
  body="$1"
  curl -sk -u "$USER_NAME:$PASSWORD" \
    -H "Content-Type: application/json" \
    -X POST "$BASE/api/pin" \
    -d "$body"
}

RESP="$(post_pin "$JSON" || true)"
case "$RESP" in
  *pairing_id* | *pairingId*)
    PAIRING_ID=""
    if command -v python3 >/dev/null 2>&1; then
      PAIRING_ID="$(curl -sk -u "$USER_NAME:$PASSWORD" "$BASE/api/pin" 2>/dev/null | python3 -c '
import json, sys
raw = sys.stdin.read()
try:
    data = json.loads(raw)
except Exception:
    sys.exit(0)
items = data
if isinstance(data, dict):
    items = data.get("pending") or data.get("pairings") or data.get("sessions") or data.get("named_certs") or []
if not isinstance(items, list):
    items = []
for it in items:
    if not isinstance(it, dict):
        continue
    pid = it.get("pairing_id") or it.get("pairingId") or it.get("id")
    if pid:
        print(pid)
        break
' || true)"
    fi
    if [ -n "$PAIRING_ID" ]; then
      JSON=$(printf '{"pairing_id":"%s","pin":"%s","name":"%s"}' "$PAIRING_ID" "$PIN" "$NAME")
      RESP="$(post_pin "$JSON" || true)"
    fi
    ;;
esac

case "$RESP" in
  *'"status":true'* | *'"status": true'* | *'"status": "true"'*)
    exit 0
    ;;
esac
if [ -n "$RESP" ]; then
  exit 0
fi
echo "error: Sunshine PIN submit failed" >&2
exit 1
