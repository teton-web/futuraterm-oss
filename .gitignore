.DS_Store
.claude/
.codegraph/

# Ghostty resources downloaded by setup.sh from davidsolheim/futuraterm-ghosttykit,
# mirroring a real Ghostty.app layout
GhosttyKit.xcframework
FuturaTerm/Resources/*
!FuturaTerm/Resources/.gitkeep
# Records which pinned release the two artifacts above came from, so bumping
# GHOSTTYKIT_TAG in setup.sh refreshes them instead of the presence checks
# silently keeping the old copy. Per-checkout state, not source.
.ghosttykit-tag

build/

# Linux frontend build products
linux/futuraterm-linux
linux/tests/test_session
linux/tests/test_path
linux/tests/test_split
linux/tests/test_layout
linux/tests/test_remote
linux/tests/test_prefs
linux/tests/test_control
linux/tests/test_model
linux/tests/test_sel
linux/tests/test_folder
linux/tests/test_desktop
linux/dist/

__pycache__/
.pytest_cache/

# Generated by xcodegen from project.yml
FuturaTerm.xcodeproj/


.env*
!.env.example

# Next.js site (website/) — never commit install artifacts or local env.
website/node_modules/
website/.next/
website/.env*
!website/.env.example
!website/.env.example.*

# Local code-signing material — never commit. The live files live under
# ~/.config/futuraterm/signing/; these globs catch copies dropped in-tree.
# Prefer signing-specific names over a blanket *.key (that would ignore
# unrelated source).
*.p12
*.pem
futuraterm-signing.*
*signing.password
*signing.key
*signing.crt
